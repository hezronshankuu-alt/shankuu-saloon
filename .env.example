# Copy this file to .env.local and fill values from Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Do NOT put a Supabase service_role key or payment secret in NEXT_PUBLIC variables.
# Payment provider secrets belong only in server-side environment variables.
PAYMENT_PROVIDER=not_configured
